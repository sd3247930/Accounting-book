{
  "name": "kunpeng-book",
  "productName": "记账APP",
  "version": "1.2.0",
  "description": "跨平台本地记账桌面应用（Electron + Vue 3 + Element Plus + SQLite）",
  "main": "electron/main.js",
  "author": "KunPengBook",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "vite build",
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "migrate:test": "electron scripts/migrate-test.js",
    "pack:win": "npm run build && electron-builder --win portable zip nsis",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-builder install-app-deps",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "echarts": "^5.6.0",
    "element-plus": "^2.9.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^37.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.kunpeng.book",
    "productName": "记账APP",
    "directories": {
      "output": "packages"
    },
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "artifactName": "KunPengBook-Setup-${version}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json",
      "!node_modules/**",
      "node_modules/better-sqlite3/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*",
      "!**/*.map",
      "!**/test/**",
      "!**/tests/**",
      "!**/deps/sqlite3/shell.c"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/build/Release/**/*"
    ],
    "win": {
      "executableName": "KunPengBook",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.finance"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "KunPengBook-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "KunPengBook-${version}-${arch}-Portable.${ext}"
    }
  }
}
